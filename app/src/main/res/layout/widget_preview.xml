<?xml version="1.0" encoding="utf-8"?>
<!--
    HOME-SCREEN-WIDGET FEATURE (Part 2/2).

    Used only as systemsgo_widget_info.xml's android:previewLayout — the static
    mock the system's "Add widget" picker inflates to represent this widget,
    never touched by SystemsGoAppWidgetProvider/RdpProfileWidgetService at
    runtime. Deliberately a *separate* layout from widget_connections_list.xml
    (the one actually placed) rather than reusing it: that real layout's
    ListView has no RemoteViewsService adapter bound in the picker context
    (setRemoteAdapter() is never called there — nothing in this app runs
    while the picker is just rendering previews), so reusing it verbatim
    would always show the empty state (widget_list_empty.xml's "No saved
    connections" text) regardless of what the user actually has saved. The
    three hardcoded example rows below give the picker a representative,
    populated look instead, the same way platform widgets like Calendar's
    agenda widget ship a populated-looking preview rather than an empty one.

    Every string/id here is literal placeholder content, inlined directly
    (not via widget_list_item.xml, whose @android:id/text1-style ids exist
    specifically for RemoteViews.setTextViewText() to target — a purpose
    this static preview has no use for) — this file is never inflated
    against the live profile list, only shown once in the widget picker.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg_outer"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_header_title"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="@drawable/widget_row_background"
            android:src="@drawable/ic_tile_quick_connect"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:orientation="vertical"
        android:background="@drawable/widget_card_background"
        android:paddingVertical="4dp">

        <!-- Mock row 1/3: a "connected" example (green dot), so the preview
             also demonstrates the live-status dot, not just the disconnected
             default every freshly-added real profile starts in. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:minHeight="56dp">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_icon_badge_background">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tile_quick_connect"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_row1_name"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_preview_row1_subtitle"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_status_dot_connected"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Mock row 2/3: disconnected. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:minHeight="56dp">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_icon_badge_background">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tile_quick_connect"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_row2_name"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_preview_row2_subtitle"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_status_dot_disconnected"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Mock row 3/3: disconnected. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:minHeight="56dp">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_icon_badge_background">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tile_quick_connect"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_row3_name"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_preview_row3_subtitle"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_status_dot_disconnected"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
