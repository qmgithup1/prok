<?xml version="1.0" encoding="utf-8"?>
<!-- HOME-SCREEN-WIDGET FEATURE (Part 1/2): base rounded-card background shared
     by both widget sizes' RemoteViews layouts — same corner radius/surface
     color language as the in-app card surfaces (NebulaSurface), just as a
     plain (non-Compose) shape drawable since RemoteViews can't host Compose.
     Color now resolves to widget_card_surface (light/dark via values /
     values-night, see colors.xml) instead of always-dark nebula_surface.
     Corner radius is a fixed 20dp fallback for API < 31 — see the
     drawable-v31 override of this same file, which ties it to the
     launcher's own system_app_widget_background_radius instead so the card
     shape matches whatever corner shape that specific launcher enforces
     (Samsung One UI, Pixel, etc. don't all agree on one radius). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card_surface" />
    <corners android:radius="20dp" />
</shape>
