<?xml version="1.0" encoding="utf-8"?>
<!--
    SHADOW-SERVER FEATURE: config for RemoteInputAccessibilityService (see
    that class's doc comment). canPerformGestures is what dispatchGesture()
    requires; canRetrieveWindowContent is what rootInActiveWindow/findFocus
    require for the keyboard-injection text-editing path. Not a
    "flyInWindow"/overlay-drawing service — no android:canRequestFilterKeyEvents
    either, since this service never needs raw system key events, only the
    already-decoded RDP scancodes arriving through AFreeRdpServerBridge.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/remote_input_accessibility_service_desc" />
